{
  "manifest_version": 3,
  "name": "OpenJarvis Context Bridge",
  "version": "1.0.0",
  "description": "Securely share browser context with OpenJarvis AI agent",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:*/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability-loader.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  }
}
